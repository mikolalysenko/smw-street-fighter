# Exercise every fighter's neutral, up, down, and buffered super in one run.
until 0100 == 07 2000
press start
until 0100 == 08 500
press start
until 0100 == 0a 500
press start
until 0100 == 14 3000
wait 90
until 1df5 == 00 4000
press b 12
until 1426 == 00 1000
until 0100 == 0e 2000
wait 60
press right 30
wait 60
press a
until 0100 == 14 3000
wait 90
press b 12
wait 30

# 0 Ryu
press a 12
wait 5
dump ryu-special
wait 120
poke 0094 80
poke 0095 00
poke 0096 60
poke 0097 01
poke 0072 00
poke 007b 00
poke 007d 00
poke 10D0A 00
press up+a 12
wait 5
dump ryu-up
wait 120
poke 0094 80
poke 0095 00
poke 0096 60
poke 0097 01
poke 0072 00
poke 007b 00
poke 007d 00
poke 10D0A 00
press down+a 12
wait 5
dump ryu-down
wait 120
poke 0094 80
poke 0095 00
poke 0096 60
poke 0097 01
poke 0072 00
poke 007b 00
poke 007d 00
poke 10D0A 00
poke 10D01 2c
poke 10D02 01
press r 30
wait 30
dump ryu-super

