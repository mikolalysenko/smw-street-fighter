wait 30
press right 10
# Reconfigure the same sprite to its valid normal state, overlapping the player.
forcepoke 14d1 08
forcepoke 00ed a8
forcepoke 14e9 00
forcepoke 00e1 60
forcepoke 14dd 01
poke 15a9 00
poke 1875 00
forcepoke 1555 00
poke 1585 01
poke 00bf 00
