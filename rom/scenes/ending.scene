# Select Chun-Li through the native roster, then use her distinct moves.
until 0100 == 07 2000
press start
until 0100 == 08 500
press start
until 0100 == 0a 500
press start
until 0100 == 0b 500
wait 40
press b 2
until 0100 == 14 3000
wait 90
until 1df5 == 00 4000
press b 12
until 1426 == 00 1000
until 0100 == 0e 2000
wait 60
press right 30
wait 60
press a
until 0100 == 14 3000
wait 30
dump roster-select
press right
press right
press b
wait 30
dump chunli-ready
press right 120
dump moving
wait 30
press a
wait 30
dump kikoken
wait 60
press up+a
wait 10
dump spinning-bird
wait 50
press down+a
wait 12
dump lightning-legs
